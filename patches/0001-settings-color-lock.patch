@@ -477,6 +477,14 @@ public class ChooseLockPassword extends SettingsActivity {
         @Override
         public View onCreateView(LayoutInflater inflater, ViewGroup container,
                 Bundle savedInstanceState) {
+            // The colour modality reuses this whole enrolment flow: the credential it produces
+            // is an ordinary numeric PIN. Only the way the digits are entered differs, so the
+            // single thing that changes is which layout is inflated.
+            if (ColorLockUtils.isColorMode(getContext(), mUserId)) {
+                final View view = inflater.inflate(R.layout.choose_lock_color, container, false);
+                ColorLockUtils.bindColorPad(view, view.findViewById(R.id.password_entry));
+                return view;
+            }
             return inflater.inflate(R.layout.choose_lock_password, container, false);
         }
 
diff --git a/src/com/android/settings/password/ColorLockUtils.java b/src/com/android/settings/password/ColorLockUtils.java
new file mode 100644
index 0000000..6d3f2aa
--- /dev/null
+++ b/src/com/android/settings/password/ColorLockUtils.java
@@ -0,0 +1,134 @@
+/*
+ * Copyright (C) 2026 DevTITANS 10 - Hands-On AOSP
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.password;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.text.Editable;
+import android.view.View;
+import android.widget.EditText;
+
+import com.android.settings.R;
+
+/**
+ * Helpers for the colour sequence screen lock.
+ *
+ * <p>The modality is deliberately implemented as a presentation layer on top of the existing
+ * numeric PIN credential: each colour of the palette maps to a fixed digit given by its position,
+ * so the sequence red-blue-green-orange is stored as the PIN {@code 1542}. Nothing about credential
+ * storage, Gatekeeper, the synthetic password or lockout handling changes.
+ *
+ * <p>The consequence is that {@link ScreenLockType#fromQuality(int)} and
+ * {@code KeyguardSecurityModel#getSecurityMode(int)} cannot distinguish a colour sequence from an
+ * ordinary PIN, because both report {@code PASSWORD_QUALITY_NUMERIC}. The user's choice is
+ * therefore recorded separately in {@link Settings.Secure} under {@link #COLOR_MODE_SETTING}, which
+ * is the single source of truth consulted by both Settings and SystemUI.
+ */
+public final class ColorLockUtils {
+
+    /**
+     * Per-user flag: {@code 1} when the colour sequence modality is active, {@code 0} (default)
+     * when the numeric credential should be entered with the ordinary PIN pad.
+     */
+    public static final String COLOR_MODE_SETTING = "lock_screen_color_mode";
+
+    /** Shortest accepted sequence. Mirrors the AOSP minimum for a PIN. */
+    public static final int MIN_LENGTH = 4;
+
+    /** Longest accepted sequence. Beyond this, memorability drops sharply. */
+    public static final int MAX_LENGTH = 8;
+
+    /**
+     * The colour keys in palette order. Index {@code i} maps to the digit {@code i + 1}; digits
+     * {@code 7}, {@code 8}, {@code 9} and {@code 0} are never produced by this modality.
+     */
+    private static final int[] KEY_IDS = {
+            R.id.color_key_1,
+            R.id.color_key_2,
+            R.id.color_key_3,
+            R.id.color_key_4,
+            R.id.color_key_5,
+            R.id.color_key_6,
+    };
+
+    private ColorLockUtils() {
+    }
+
+    /** Whether {@code userId} unlocks with a colour sequence rather than a numeric PIN pad. */
+    public static boolean isColorMode(Context context, int userId) {
+        if (context == null) {
+            return false;
+        }
+        return Settings.Secure.getIntForUser(
+                context.getContentResolver(), COLOR_MODE_SETTING, 0, userId) != 0;
+    }
+
+    /**
+     * Records whether {@code userId} uses the colour modality. Called when a lock type is chosen,
+     * and again with {@code false} if enrolment is abandoned, so the flag never outlives the
+     * credential it describes.
+     */
+    public static void setColorMode(Context context, int userId, boolean enabled) {
+        if (context == null) {
+            return;
+        }
+        Settings.Secure.putIntForUser(
+                context.getContentResolver(), COLOR_MODE_SETTING, enabled ? 1 : 0, userId);
+    }
+
+    /**
+     * Wires the colour keys of {@code root} so that tapping them appends the matching digit to
+     * {@code target}, which is the ordinary password field of the enrolment screen. The soft
+     * keyboard is suppressed, since the palette is the only intended input method here.
+     *
+     * @param root   the inflated colour layout
+     * @param target the credential field, normally {@code R.id.password_entry}
+     */
+    public static void bindColorPad(View root, EditText target) {
+        if (root == null || target == null) {
+            return;
+        }
+        target.setShowSoftInputOnFocus(false);
+
+        for (int i = 0; i < KEY_IDS.length; i++) {
+            final View key = root.findViewById(KEY_IDS[i]);
+            if (key == null) {
+                continue;
+            }
+            final String digit = String.valueOf(i + 1);
+            key.setOnClickListener(v -> {
+                if (target.getText().length() < MAX_LENGTH) {
+                    target.append(digit);
+                }
+            });
+        }
+
+        final View delete = root.findViewById(R.id.color_key_delete);
+        if (delete != null) {
+            delete.setOnClickListener(v -> {
+                final Editable text = target.getText();
+                if (text.length() > 0) {
+                    text.delete(text.length() - 1, text.length());
+                }
+            });
+            delete.setOnLongClickListener(v -> {
+                target.setText("");
+                return true;
+            });
+        }
+    }
+}
