+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2026 DevTITANS 10 - Hands-On AOSP
+
+     Accessibility labels for the colour sequence bouncer. Without these a screen reader would
+     announce the digit behind each key and read the user's sequence out loud.
+-->
+<resources>
+    <string name="color_lock_red_description">Red</string>
+    <string name="color_lock_orange_description">Orange</string>
+    <string name="color_lock_yellow_description">Yellow</string>
+    <string name="color_lock_green_description">Green</string>
+    <string name="color_lock_blue_description">Blue</string>
+    <string name="color_lock_purple_description">Purple</string>
+    <string name="keyguard_enter_your_color">Enter your color sequence</string>
+</resources>
diff --git a/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityViewFlipperController.java b/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityViewFlipperController.java
index bc5b1ba..b43f530 100644
--- a/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityViewFlipperController.java
+++ b/packages/SystemUI/src/com/android/keyguard/KeyguardSecurityViewFlipperController.java
@@ -16,6 +16,7 @@
 
 package com.android.keyguard;
 
+import android.provider.Settings;
 import android.util.Log;
 import android.view.LayoutInflater;
 
@@ -45,6 +46,13 @@ public class KeyguardSecurityViewFlipperController
     private static final boolean DEBUG = KeyguardConstants.DEBUG;
     private static final String TAG = "KeyguardSecurityView";
 
+    /**
+     * Per-user flag written by Settings when the colour sequence lock is chosen. Kept as a
+     * literal here because Settings and SystemUI share no source; the two definitions must stay
+     * in sync with {@code ColorLockUtils.COLOR_MODE_SETTING}.
+     */
+    private static final String COLOR_MODE_SETTING = "lock_screen_color_mode";
+
     private final List<KeyguardInputViewController<KeyguardInputView>> mChildren =
             new ArrayList<>();
     private final LayoutInflater mLayoutInflater;
@@ -142,7 +150,13 @@ public class KeyguardSecurityViewFlipperController
     private int getLayoutIdFor(SecurityMode securityMode) {
         switch (securityMode) {
             case Pattern: return R.layout.keyguard_pattern_view;
-            case PIN: return R.layout.keyguard_pin_view;
+            // A colour sequence is stored as a numeric PIN, so getSecurityMode() reports PIN for
+            // both modalities. The stored preference is what tells them apart, and the only
+            // difference is which keypad the user is shown; the view class, its ids and the
+            // controller behind them are identical.
+            case PIN: return isColorModeEnabled()
+                    ? R.layout.keyguard_color_view
+                    : R.layout.keyguard_pin_view;
             case Password: return R.layout.keyguard_password_view;
             case SimPin: return R.layout.keyguard_sim_pin_view;
             case SimPuk: return R.layout.keyguard_sim_puk_view;
@@ -151,6 +165,19 @@ public class KeyguardSecurityViewFlipperController
         }
     }
 
+    /**
+     * Whether the current user enrolled their numeric credential through the colour sequence
+     * modality. Written by Settings when the lock type is chosen; see
+     * {@code com.android.settings.password.ColorLockUtils}.
+     */
+    private boolean isColorModeEnabled() {
+        return Settings.Secure.getIntForUser(
+                mView.getContext().getContentResolver(),
+                COLOR_MODE_SETTING,
+                0,
+                KeyguardUpdateMonitor.getCurrentUser()) != 0;
+    }
+
     private int getKeyguardInputViewId(SecurityMode securityMode) {
         //Keyguard Input View is not the root view of the layout, use these IDs for lookup.
         switch (securityMode) {
